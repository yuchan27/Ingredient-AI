NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=食伴 AI
SMTP_FROM_EMAIL=your-account@gmail.com

GEMINI_API_KEY=your-google-ai-studio-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional legacy Storage path. Spark mode uploads images directly to this API.
FIREBASE_STORAGE_BUCKET=

# Daily AI quotas are enforced in Firestore: anonymous=5, verified Email=50.
# Cloud Run uses Application Default Credentials; do not deploy service-account keys.

API_BASE_URL=http://localhost:3000
